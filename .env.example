# Copy this file to .env only on your local machine or Oracle VM. Never commit .env.
open_router_url=https://your-openrouter-compatible-endpoint/v1
open_router_api_key=replace-with-your-key
llama_guard_rail_model=replace-with-guard-model
llama_chat_model=replace-with-chat-model
embedding_model=replace-with-embedding-model
TAVILY_API_KEY=replace-with-your-key
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Docker-internal service URLs
DATABASE_URL=postgresql://research_admin:replace-with-strong-password@research-vector-db:5432/research_assistant_db
POSTGRES_PASSWORD=replace-with-the-same-strong-password
REDIS_URL=redis://job-queue-cache:6379/0
MCP_SERVER_SSE_URL=http://mcp-server-service:8080/sse

# Production public settings
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
CORS_ORIGINS=https://ai-research-analyst-assistant.streamlit.app
